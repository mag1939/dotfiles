{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/mag/Pictures/towa-ascii-art.png",
    "width": 48,
    "padding": {
      "left": 2,
      "top": 2
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "host",
      "key": " 󰌢 ",
      "keyColor": "#7d309e"
    },
    {
      "type": "bios",
      "key": " 󰊤 BIOS",
      "keyColor": "#7d309e"
    },
    {
      "type": "bootmgr",
      "key": " 󰍛 Boot",
      "keyColor": "#7d309e"
    },
    {
      "type": "kernel",
      "key": " 󰌽 Kernel",
      "keyColor": "#7d309e"
    },
    {
      "type": "os",
      "key": " 󰣇 OS",
      "keyColor": "#7d309e"
    },
    {
      "type": "wm",
      "format": "{1} + Dux Shell",
      "key": " 󱂬 WM",
      "keyColor": "#7d309e"
    },
    {
      "type": "shell",
      "key": " 󰞷 Shell",
      "keyColor": "#7d309e"
    },
    {
      "type": "terminal",
      "key": " 󰆍 Terminal",
      "keyColor": "#7d309e"
    },
    {
      "type": "lm",
      "key": " 󱂬 LoginMgr",
      "keyColor": "#7d309e"
    },
    {
      "type": "display",
      "key": " 󰍹 ",
      "keyColor": "#bb389b"
    },
    {
      "type": "cpu",
      "key": " 󰻠 CPU",
      "keyColor": "#bb389b"
    },
    {
      "type": "gpu",
      "key": " 󰢮 GPU",
      "keyColor": "#bb389b"
    },
    {
      "type": "memory",
      "key": " 󰍛 RAM",
      "keyColor": "#bb389b"
    },
    {
      "type": "disk",
      "key": " 󰋊 Home",
      "folders": "/home",
      "keyColor": "#bb389b"
    },
    {
      "type": "disk",
      "key": " 󰋊 SSD2",
      "folders": "/mnt/SSD2",
      "keyColor": "#bb389b"
    },
    {
      "type": "command",
      "key": " 󰔛 OS Age",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
      "keyColor": "#89a838"
    },
    {
      "type": "uptime",
      "key": " 󰅐 Uptime",
      "keyColor": "#89a838"
    },
    "break",
    "colors",
    "break"
  ]
}
