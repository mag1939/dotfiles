configuration {
	display-drun: "Applications:";
	display-calc: "Calculator:";
	display-window: "Windows:";
	display-emoji: "Emoji:";
	drun-display-format: "{icon} {name}";
	modi: "drun,emoji,calc,window";
	show-icons: true;
	icon-theme: "Papirus";
  calc {
        no-bold: false;
        terse: true;
        no-history: false;
        no-persist-history: false;
        automatic-save-to-history: true;
        calc-command-history: true;
        calc-command: "echo -n '{result}' | wl-copy";
        calc-error-color: "Green";
        hint-result: "Result: ";
        hint-welcome: "";
    }
}

@theme "/dev/null"

* {
  bg: #1e1e2e;
  bg-alt: #585b70;
  bg-selected: #313244;

  fg: #cdd6f4;
  fg-alt: #7f849c;


  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 45%;
  background-color: @bg;
  border-radius: 8px;
}

element {
  padding: 12;
  background-color: transparent;
  text-color: @fg-alt;
}

element selected {
  text-color: @fg;
  background-color: @bg-selected;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
}

element-icon {
  size: 30;
  background-color: transparent;
}

entry {
  padding: 12;
  background-color: @bg-alt;
  text-color: @fg;
}

inputbar {
  children: [prompt, entry];
  background-color: @bg;
}

listview {
  background-color: @bg;
  columns: 1;
  lines: 10;
}

mainbox {
  children: [inputbar, message, listview];
  background-color: @bg;
}

prompt {
  enabled: true;
  padding: 12 0 0 12;
  background-color: @bg-alt;
  text-color: @fg;
}
