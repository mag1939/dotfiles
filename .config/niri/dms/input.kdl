// ! AUTO-GENERATED BY DMS !
// ! CHANGES WILL BE OVERWRITTEN !
// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !

input {
    focus-follows-mouse max-scroll-amount="0%"
    mouse {
        accel-speed 0.0
        scroll-factor 1.5
    }
    touchpad {
        tap
        accel-speed 0.0
        natural-scroll
        disabled-on-external-mouse
        dwt
    }
    keyboard {
        xkb {
            layout "us,th"
            options "grp:caps_toggle"
        }
        numlock
    }
}
