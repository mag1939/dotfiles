// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1792933396794714127 @name=moe.launcher.the-honkers-railway-launcher
window-rule {
    match app-id="^moe.launcher.the-honkers-railway-launcher$"
    open-maximized true
}

// @id=wr_1792933538525788813 @name=moe.launcher.an-anime-game-launcher
window-rule {
    match app-id="^moe.launcher.an-anime-game-launcher$"
    open-maximized true
}

// @id=wr_1792933552717725063 @name=steam
window-rule {
    match app-id="^steam$"
    open-maximized true
}

// @id=wr_1792946268522055950 @name=dev.duxlabs.shell
window-rule {
    match app-id="^dev.duxlabs.shell$"
