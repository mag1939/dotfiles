}

// @id=wr_1792984434983715278 @name=discord
window-rule {
    match app-id="^discord$"
    open-maximized true
}

// @id=wr_1792985022058707294 @name=dev.duxlabs.calendar
window-rule {
    match app-id="^dev.duxlabs.calendar$"
}

// @id=wr_1792986844728251927 @name=helium
window-rule {
