

// ========================== window-rule ==========================

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id="steam"
    exclude title=r"^[Ss]team$"

    open-floating true
}

window-rule {
   match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
   default-floating-position x=10 y=10 relative-to="bottom-right"
   open-focused false
}

window-rule {
    match app-id=r"^firefox$"
    match app-id=r"^google-chrome$"
    match app-id=r"^md\.obsidian\.Obsidian$"
    match app-id=r"^com\.github\.iwalton3\.jellyfin-mpv-shim$"
    match app-id=r"^zen$"
    match app-id=r"^helium$"
    match app-id=r"^com\.microsoft\.VSCode$"
    match app-id=r"^krita$"
    match app-id=r"^com\.obsproject\.Studio$"
    match app-id=r"^ONLYOFFICE$"
	match app-id=r"^io\.github\.hkdb\.Aerion$"
	match app-id=r"^vesktop$"
	match app-id=r"^moe\.launcher\.the-honkers-railway-launcher$"
	match app-id=r"^moe\.launcher\.an-anime-game-launcher$"
	match app-id=r"^steam$"

	match app-id=r"^ai\.storyteller\.photocraft$"
	match app-id=r"^ai\.storyteller\.artcraft-launcher$"
	match app-id=r"^ai\.storyteller\.filmcraft$"
	match app-id=r"^ai\.storyteller\.pdfcraft$"
	match app-id=r"^ai\.storyteller\.wordcraft$"
	match app-id=r"^ai\.storyteller\.deckcraft$"
	match app-id=r"^ai\.storyteller\.gridcraft$"
    open-maximized true
}

// ========================== layer-rule ==========================

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}
