binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── noctalia-shell keybinds ───
    // https://docs.noctalia.dev/getting-started/keybinds/

    // run scripts
    Mod+F1 { spawn "/home/mag/HOME-SERVER-STORAGE/shared-codes-files/batch-script/wondershaper-fast_internet.sh"; }
    Mod+F2 { spawn "/home/mag/HOME-SERVER-STORAGE/shared-codes-files/batch-script/wondershaper-slow_internet.sh"; }
    Mod+F3 { spawn "/home/mag/HOME-SERVER-STORAGE/shared-codes-files/batch-script/wondershaper-very_slow_internet.sh"; }

    // ปุ่มฉุกเฉินเปิดหน้าจอ laptop
    Mod+P 			{ spawn "niri" "msg" "output" "eDP-1" "on"; }


    // ─── Applications ───
    Mod+T hotkey-overlay-title="Open Terminal: Kitty" { spawn "kitty"; }
    Mod+W hotkey-overlay-title="Open Browser: Zen" { spawn "helium-browser"; }
    Mod+Space repeat=false { spawn "vicinae" "toggle"; }

  // ========== [DMS (Dux Shell)] =============
      Mod+Shift+W hotkey-overlay-title="Open Wallpaper Selector: dms wallpaper" { spawn "dms" "ipc" "call" "wallpaper" "toggle"; }
      Mod+S hotkey-overlay-title="Open Control Center: dms control-center" { spawn "dms" "ipc" "call" "control-center" "toggle"; }
      Mod+slash hotkey-overlay-title="Open Settings: dms settings" { spawn "dms" "ipc" "call" "settings" "toggle"; }
      Mod+ALT+L hotkey-overlay-title="Lock Screen: dms lock" { spawn "dms" "ipc" "call" "lockscreen" "lock"; }
      Mod+X hotkey-overlay-title="Session Menu: dms session" { spawn "dms" "ipc" "call" "session" "toggle"; }
      Mod+V hotkey-overlay-title="Toggle Clipboard: dms clipboard" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
      PRINT hotkey-overlay-title="Screenshot Fullscreen" { spawn "niri" "msg" "action" "screenshot"; }
      
      // ========== Media & System Controls =========
      XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
      XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
      XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
      XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
      XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
      XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
      XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
      XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
      XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+10%"; }
      XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "10%-"; }

    // Text Editor
    // Mod+Shift+E              hotkey-overlay-title="Open Text Editor: Zed" { spawn "zed"; }

    // Toggle File Manager
    Mod+E hotkey-overlay-title="File Manager: Thunar" { spawn "thunar"; }

    // ─── Window Movement and Focus ───
    Mod+Q                               { close-window; }
    Mod+Left                            { focus-column-left; }
    Mod+H                               { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+L                               { focus-column-right; }

    Mod+CTRL+Left                       { move-column-left; }
    Mod+CTRL+H                          { move-column-left; }
    Mod+CTRL+Right                      { move-column-right; }
    Mod+CTRL+L                          { move-column-right; }

    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }

    Mod+Shift+Left                      { focus-monitor-left; }
    Mod+Shift+Right                     { focus-monitor-right; }
    Mod+Shift+UP                        { focus-monitor-up; }
    Mod+Shift+Down                      { focus-monitor-down; }


    // ─── Workspace Switching ───
    Mod+WheelScrollDown cooldown-ms=150 	{ focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 		{ focus-workspace-up; }
    Mod+UP  					{ focus-workspace-up; }
    Mod+K                          		{ focus-workspace-up; }
    Mod+Down                       		{ focus-workspace-down; }
    Mod+J                          		{ focus-workspace-down; }

    Mod+CTRL+UP                         	{ move-column-to-workspace-up; }
    Mod+CTRL+K                          	{ move-column-to-workspace-up; }
    Mod+CTRL+Down                       	{ move-column-to-workspace-down; }
    Mod+CTRL+J                          	{ move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollDown cooldown-ms=150 	{ move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp cooldown-ms=150 	{ move-column-to-workspace-up; }

    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }

    Mod+TAB repeat=false { toggle-overview; }

    // ─── Modes ───
    Mod+CTRL+F                          { toggle-window-floating; }
    Mod+F                               { maximize-column; }
    Mod+Shift+F                         { fullscreen-window; }
    Mod+M                               { maximize-window-to-edges; }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+ESCAPE allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
